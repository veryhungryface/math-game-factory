ad"]},{"id":"m1s1-u4-012","prompt":"다음 중 y가 x에 정비례하는 것을 고르시오.","answer_mode":"choice","answer":"y=3x","choices":["y=3x","y=x+3","xy=3","y=3"],"format":"text","explain":"y=ax(a≠0) 꼴이므로 y=3x입니다.","unitConcept":"정비례","difficulty":1,"distractor_tags":["m1s1-u4.constant-added","m1s1-u4.inverse-confused","m1s1-u4.constant-function"]},{"id":"m1s1-u4-013","prompt":"다음 중 y가 x에 반비례하는 것을 고르시오.","answer_mode":"choice","answer":"xy=6","choices":["y=6x","y=x−6","xy=6","x+y=6"],"format":"text","explain":"두 수의 곱 xy가 일정하므로 반비례입니다.","unitConcept":"반비례","difficulty":1,"distractor_tags":["m1s1-u4.direct-confused","m1s1-u4.linear-confused","m1s1-u4.sum-constant"]},{"id":"m1s1-u4-014","prompt":"y가 x에 정비례하고, x=2일 때 y=10이다. y를 x에 대한 식으로 나타내시오.","answer_mode":"choice","answer":"y=5x","choices":["y=5x","xy=20","y=x+8","y=20x"],"format":"text","explain":"y=ax에 대입하면 10=2a, a=5이므로 y=5x입니다.","unitConcept":"정비례","difficulty":1,"distractor_tags":["m1s1-u4.inverse-confused","m1s1-u4.difference-used","m1s1-u4.multiply-instead"]},{"id":"m1s1-u4-015","prompt":"y가 x에 반비례하고, x=2일 때 y=6이다. x와 y 사이의 관계를 식으로 나타내시오.","answer_mode":"choice","answer":"xy=12","choices":["y=3x","xy=3","y=12x","xy=12"],"format":"text","explain":"반비례이면 xy가 일정하므로 xy=2×6=12입니다.","unitConcept":"반비례","difficulty":1,"distractor_tags":["m1s1-u4.direct-confused","m1s1-u4.divide-instead","m1s1-u4.direct-confused"]},{"id":"m1s1-u4-016","prompt":"정비례 관계 y=ax(a≠0)의 그래프가 항상 지나는 점을 고르시오.","answer_mode":"choice","answer":"(0, 0)","choices":["(1, 1)","(0, 0)","(0, 1)","(1, 0)"],"format":"text","explain":"x=0이면 y=0이므로 그래프는 항상 원점을 지납니다.","unitConcept":"정비례 관계의 그래프","difficulty":1,"distractor_tags":["m1s1-u4.slope-one","m1s1-u4.intercept-confused","m1s1-u4.axis-confused"]},{"id":"m1s1-u4-017","prompt":"다음 중 정비례 관계 y=2x의 그래프 위의 점을 고르시오.","answer_mode":"choice","answer":"(3, 6)","choices":["(6, 3)","(3, 6)","(−1, 2)","(2, 2)"],"format":"text","explain":"x=3을 대입하면 y=6이므로 (3, 6)이 그래프 위의 점입니다.","unitConcept":"정비례 관계의 그래프","difficulty":1,"distractor_tag