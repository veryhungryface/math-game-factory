{
  "type": "object",
  "additionalProperties": false,
  "required": ["comprehensible", "confusion_points", "onboarding_quality", "title_issues", "severity"],
  "properties": {
    "comprehensible": {
      "type": "string",
      "enum": ["yes", "partial", "no"]
    },
    "confusion_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "issue"],
        "properties": {
          "frame": { "type": "string", "description": "관련 프레임 파일명 또는 시점 (예: frame-03-t027-play)" },
          "issue": { "type": "string", "description": "그 시점에 무엇이 불명확한지 구체적으로" }
        }
      }
    },
    "onboarding_quality": {
      "type": "string",
      "description": "규칙 설명이 존재하는가/충분한가에 대한 평가"
    },
    "title_issues": {
      "type": "string",
      "description": "타이틀·태그라인이 게임 내용을 예고하는가에 대한 평가"
    },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  }
}
