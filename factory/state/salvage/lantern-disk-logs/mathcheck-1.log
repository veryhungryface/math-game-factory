   520	    P.push({id:'fill-d-'+r, prompt:'지름이 '+fmtCm(d)+'인 원의 넓이는? (원주율 약 3.14)',
   521	      choices:pickChoices(correct,cands,[{s:fmtArea(d*d*100),misconceptionId:'GHOST_FORGOT_PI'}],g),
   522	      answer:correct, answerNumeric:A/100, unitConcept:'원의 넓이 = 반지름 × 반지름 × 원주율'});
   523	  }
   524	  // 반지름 2배 → 넓이 4배 (배율)
   525	  for(const r of [1,2,3,4,5,6,8,10]){
   526	    const correct='4배';
   527	    P.push({id:'scale-m-'+r, prompt:'반지름이 '+fmtCm(r)+'인 원의 반지름을 2배로 하면 넓이는 몇 배가 되는가?',
