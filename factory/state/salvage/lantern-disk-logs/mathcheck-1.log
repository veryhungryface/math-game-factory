  1008	function confirmLight(fromTest, forceOk){
  1009	  if(S.phase!=='playing' && !fromTest) return;
  1010	  if(S.lockInput && !fromTest) return;
  1011	  const task=S.task;
  1012	  if(!task){ return; }
  1013	  const rInt=Math.round(S.rFloat);
  1014	  const ok = forceOk || (S.mode===task.modeTarget && rInt===task.rTarget);
  1015	  if(ok) applyCorrect(fromTest);
  1016	  else applyWrong(fromTest);
  1017	}
