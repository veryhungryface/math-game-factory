function burst(x,y,n,cols,up){
  n = Math.min(80 - S.parts.length, Math.round(n*MO));
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2, sp=40+Math.random()*180;
    S.parts.push({x,y,vx:Math.cos(a)*sp*(up?0.4:1), vy:Math.sin(a)*sp-(up?120:0),
      life:0.5+Math.random()*0.6, t:0, r:2+Math.random()*4, c:cols[i%cols.length]});
  }
}
