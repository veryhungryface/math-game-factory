<script>
(() => {
/* ════════════════════════════════════════════════════════════
   정수 백분위 모델. PI100=314. 부동소수점 비교 금지.
   C100 = d * 314    A100 = r * r * 314
   remain100 = d*d*100 - r*r*314
   ════════════════════════════════════════════════════════════ */
const PI100 = 314;
const LS_BEST = 'lantern-disk:best';
const LS_COMBO = 'lantern-disk:bestCombo';
const LS_ONB = 'onboardingSeen:lantern-disk';
const LS_CLEAR = 'lantern-disk:cleared';
const LS_SPRINT = 'lantern-disk:sprintBest';
const LS_DEX = 'lantern-disk:dex';

function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);
  t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296}}
const RNG = mulberry32((Date.now() ^ 0xC14C1E) >>> 0);
function shuf(g, a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(g()*(i+1));const t=a[i];a[i]=a[j];a[j]=t}return a}
function clamp(v,a,b){return v<a?a:v>b?b:v}
function lerp(a,b,t){return a+(b-a)*t}
function fmt(h){
  const neg=h<0; h=Math.abs(Math.round(h));
  const i=Math.floor(h/100), f=h%100;
  let s;
  if(f===0) s=String(i);
  else if(f%10===0) s=i+'.'+(f/10);
  else s=i+'.'+String(f).padStart(2,'0');
  return (neg?'-':'')+s;
}
function fmtCm(n){return n+' cm'}
function fmtLen(h){return fmt(h)+' cm'}
function fmtArea(h){return fmt(h)+' cm²'}
function C100(r){return 2*r*PI100}
function A100(r){return r*r*PI100}
function remain100(r){const d=2*r; return d*d*100 - r*r*PI100}

/**
 * 오답 후처리: 정답 제거 → 범위 검사 → 중복 제거 → 부족분 보충 → 셔플
 * cands[].misconceptionId 는 오개념 역산 표식 (검산관 확인용)
 */
function pickChoices(correctStr, cands, extras, g){
  const seen=new Set([String(correctStr)]);
  const dist=[];
  const add=(c)=>{
    if(!c||c.s==null) return;
    const s=String(c.s);
    if(!s||seen.has(s)) return;
    if(c.ok===false) return;
    seen.add(s); dist.push(s);
  };
  for(const c of cands) add(c);
  if(extras) for(const c of extras){ if(dist.length>=3) break; add(c); }
  let k=1;
  while(dist.length<3 && k<40){
    const s=String(correctStr).replace(/[\d.]+/, (n)=>{
      const v=Math.round(Number(n)*100)+k*100; k++; return fmt(v);
    });
    k++;
    if(!seen.has(s) && s!==String(correctStr)){ seen.add(s); dist.push(s); }
  }
  return shuf(g||RNG, [String(correctStr)].concat(dist.slice(0,3)));
}

function buildMcPool(){
  const P=[], g=mulberry32(0x51C1E5);
  // 원주 — 지름 제시. 오개념: π=3 / 반지름×π / 지름을 반지름으로(×2) / 넓이 공식
  for(const r of [1,2,3,4,5,6,8,10]){
    const d=2*r, C=C100(r), correct=fmtLen(C);
    const cands=[
      {s:fmtLen(d*300), misconceptionId:'GHOST_PI_IS_3'},       // 원주율을 3으로
      {s:fmtLen(r*PI100), misconceptionId:'GHOST_USE_R'},       // 반지름 × 약 3.14
      {s:fmtLen((2*d)*PI100), misconceptionId:'GHOST_D_AS_R'},  // 지름을 반지름 자리에
      {s:fmtLen(A100(r)), misconceptionId:'GHOST_SWAP'}         // 넓이 공식을 둘레에
    ];
    const extras=[
      {s:fmtLen(d*100), misconceptionId:'GHOST_FORGOT_PI'},
      {s:fmtLen(r*100), misconceptionId:'GHOST_GAVE_R'}
    ];
    P.push({id:'rim-d-'+r, prompt:'지름이 '+fmtCm(d)+'인 원의 둘레는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,extras,g), answer:correct, answerNumeric:C/100,
      unitConcept:'원주 = 지름 × 원주율'});
  }
  // 원주 — 반지름 제시
  for(const r of [1,2,3,4,5,6,8,10]){
    const d=2*r, C=C100(r), correct=fmtLen(C);
    const cands=[
      {s:fmtLen(d*300), misconceptionId:'GHOST_PI_IS_3'},
      {s:fmtLen(r*PI100), misconceptionId:'GHOST_USE_R'},
      {s:fmtLen((2*d)*PI100), misconceptionId:'GHOST_D_AS_R'},
      {s:fmtLen(A100(r)), misconceptionId:'GHOST_SWAP'}
    ];
    P.push({id:'rim-r-'+r, prompt:'반지름이 '+fmtCm(r)+'인 원의 둘레는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtLen(d*100),misconceptionId:'GHOST_FORGOT_PI'}],g),
      answer:correct, answerNumeric:C/100, unitConcept:'원주 = 지름 × 원주율'});
  }
  // 넓이 — 반지름 제시. r=2 는 r×2 와 r×r 이 같아 제외 (구조적 보장)
  for(const r of [1,3,4,5,6,7,8,9,10]){
    const d=2*r, A=A100(r), correct=fmtArea(A);
    const cands=[
      {s:fmtArea(r*2*PI100), misconceptionId:'GHOST_R_TIMES_TWO'}, // 반지름×2×π (제곱 대신 두 배)
      {s:fmtArea(C100(r)), misconceptionId:'GHOST_SWAP'},          // 둘레 공식으로 안을 채움 (값은 위와 같으면 중복 제거)
      {s:fmtArea(d*d*PI100), misconceptionId:'GHOST_D_AS_R'},      // 지름을 반지름 자리에
      {s:fmtArea(r*r*300), misconceptionId:'GHOST_PI_IS_3'}        // π=3
    ];
    P.push({id:'fill-r-'+r, prompt:'반지름이 '+fmtCm(r)+'인 원의 넓이는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtArea(r*PI100),misconceptionId:'GHOST_R_NOT_SQUARE'}],g),
      answer:correct, answerNumeric:A/100, unitConcept:'원의 넓이 = 반지름 × 반지름 × 원주율'});
  }
  // 넓이 — 지름 제시
  for(const r of [1,3,4,5,6,8,10]){
    const d=2*r, A=A100(r), correct=fmtArea(A);
    const cands=[
      {s:fmtArea(d*d*PI100), misconceptionId:'GHOST_D_AS_R'},
      {s:fmtArea(d*PI100), misconceptionId:'GHOST_SWAP'},
      {s:fmtArea(r*r*300), misconceptionId:'GHOST_PI_IS_3'},
      {s:fmtArea(r*2*PI100), misconceptionId:'GHOST_R_TIMES_TWO'}
    ];
    P.push({id:'fill-d-'+r, prompt:'지름이 '+fmtCm(d)+'인 원의 넓이는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtArea(d*d*100),misconceptionId:'GHOST_FORGOT_PI'}],g),
      answer:correct, answerNumeric:A/100, unitConcept:'원의 넓이 = 반지름 × 반지름 × 원주율'});
  }
  // 반지름 2배 → 넓이 4배 (배율)
  for(const r of [1,2,3,4,5,6,8,10]){
    const correct='4배';
    P.push({id:'scale-m-'+r, prompt:'반지름이 '+fmtCm(r)+'인 원의 반지름을 2배로 하면 넓이는 몇 배가 되는가?',
      choices:pickChoices(correct,[
        {s:'2배', misconceptionId:'GHOST_LINEAR_AREA'},
        {s:'8배', misconceptionId:'GHOST_CUBED'},
        {s:'3.14배', misconceptionId:'GHOST_PI_AS_SCALE'}
      ],[{s:'6배'}],g), answer:correct, answerNumeric:4,
      unitConcept:'반지름이 2배면 넓이는 4배'});
  }
  // 반지름 2배 → 새 넓이 값
  for(const r of [3,4,5]){
    const R=2*r, A=A100(R), correct=fmtArea(A);
    const cands=[
      {s:fmtArea(2*A100(r)), misconceptionId:'GHOST_LINEAR_AREA'}, // 넓이도 2배
      {s:fmtArea((2*R)*(2*R)*PI100), misconceptionId:'GHOST_D_AS_R'}, // 새 지름을 반지름처럼
      {s:fmtArea(R*2*PI100), misconceptionId:'GHOST_R_TIMES_TWO'}
    ];
    P.push({id:'scale-a-'+r, prompt:'반지름이 '+fmtCm(r)+'인 원의 반지름을 2배('+fmtCm(R)+')로 늘리면 넓이는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtArea(A100(r)),misconceptionId:'GHOST_NO_SCALE'}],g),
      answer:correct, answerNumeric:A/100, unitConcept:'반지름이 2배면 넓이는 4배'});
  }
  // 정사각형 − 내접원. r=2 는 A=C 라서 둘레를 빼는 오답이 정답과 같아져 제외
  for(const r of [3,4,5,6,8,10]){
    const d=2*r, rem=remain100(r), correct=fmtArea(rem);
    const sq=d*d*100;
    const cands=[
      {s:fmtArea(sq), misconceptionId:'GHOST_NO_SUB'},                 // 원을 안 뺌
      {s:fmtArea(sq-C100(r)), misconceptionId:'GHOST_SWAP'},            // 둘레를 넓이처럼 뺌
      {s:fmtArea(A100(r)), misconceptionId:'GHOST_JUST_CIRCLE'},        // 원 넓이만 답
      {s:fmtArea(sq-r*r*300), misconceptionId:'GHOST_PI_IS_3'}
    ];
    P.push({id:'remain-'+r, prompt:'한 변이 '+fmtCm(d)+'인 정사각형 안에 지름이 '+fmtCm(d)+'인 원이 꼭 맞게 들어 있을 때, 색칠한 부분(정사각형에서 원을 뺀 부분)의 넓이는? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtArea(sq-r*PI100),misconceptionId:'GHOST_D_AS_R'}],g),
      answer:correct, answerNumeric:rem/100, unitConcept:'색칠한 부분의 넓이'});
  }
  // 원주로 지름 구하기
  for(const d of [4,6,8,10,12,16,20]){
    const C=d*PI100, correct=fmtCm(d);
    const cands=[
      {s:fmtCm(d/2), misconceptionId:'GHOST_GAVE_R'},
      {s:fmtCm(2*d), misconceptionId:'GHOST_D_AS_R'},
      {s:fmt(C)+' cm', misconceptionId:'GHOST_GAVE_C'}
    ];
    P.push({id:'rev-d-'+d, prompt:'둘레가 '+fmtLen(C)+'인 원의 지름은? (원주율 약 3.14)',
      choices:pickChoices(correct,cands,[{s:fmtCm(d+2)}],g),
      answer:correct, answerNumeric:d, unitConcept:'원주 = 지름 × 원주율'});
  }
  // 식별(계산 없음)
  P.push({id:'id-rim', prompt:'나방이 원 둘레 길을 걸어요. 등잔을 어떻게 켤까요?',
    choices:shuf(g,['테두리에 줄을 두른다','안을 기름 칸으로 채운다','지름 숫자만 켠다','원주율만 켠다']),
    answer:'테두리에 줄을 두른다', answerNumeric:1, unitConcept:'원주'});
  P.push({id:'id-fill', prompt:'나방이 원 안 꽃밭에 앉아요. 등잔을 어떻게 켤까요?',
    choices:shuf(g,['안을 기름 칸으로 채운다','테두리에 줄을 두른다','지름 숫자만 켠다','원주율만 켠다']),
    answer:'안을 기름 칸으로 채운다', answerNumeric:2, unitConcept:'원의 넓이'});
  P.push({id:'id-pi', prompt:'계산에서 쓰는 3.14에 대한 설명으로 옳은 것은?',
    choices:shuf(g,['3.14는 원주율의 근삿값이다','원주율은 딱 3.14이다','원주율은 3이다','원주율은 지름이다']),
    answer:'3.14는 원주율의 근삿값이다', answerNumeric:3.14, unitConcept:'원주율(근삿값 3.14)'});
  P.push({id:'id-contract', prompt:'이 등잔에서 둘레와 넓이를 바르게 짝지은 것은?',
    choices:shuf(g,['줄 길이=둘레, 칸 수=넓이','줄 길이=넓이, 칸 수=둘레','지름=넓이, 반지름=둘레','원주율=넓이']),
    answer:'줄 길이=둘레, 칸 수=넓이', answerNumeric:1, unitConcept:'원주와 넓이 구별'});
  return P;
}
const MC_POOL = buildMcPool();

function sampleProblems(n){
  const g=mulberry32(0xA11CE);
  const seen=new Set(), uniq=[];
  for(const p of shuf(g, MC_POOL)){
    if(seen.has(p.prompt)) continue;
    seen.add(p.prompt); uniq.push(p);
  }
  return uniq.slice(0, Math.max(1, n|0));
}

/* ── 플레이 슬롯 풀 (전수, 제약 만족) ───────────────────── */
function buildPlaySlots(){
  const S=[];
  // L1 둘레 길. r∈{2,5,10} 림만. 고스트 없음
  for(const r of [2,5,10]) S.push({level:1, kind:'rim', r, given:'d', ghosts:[]});
  // L2 지름 표지판. GHOST_D_AS_R
  for(const r of [3,4,5]) S.push({level:2, kind:'rim', r, given:'d', ghosts:['GHOST_D_AS_R','GHOST_PI_IS_3']});
  // L3 꽃밭. r=2 제외(제곱=두 배). GHOST_R_TIMES_TWO + GHOST_SWAP
  for(const r of [4,5,10]) S.push({level:3, kind:'fill', r, given:'r', ghosts:['GHOST_R_TIMES_TWO','GHOST_SWAP','GHOST_D_AS_R']});
  // L4 두 배
  for(const r of [2,4,5]) S.push({level:4, kind:'scale4', sub:'fill', r, given:'r', ghosts:['GHOST_LINEAR_AREA']});
  for(const r of [2,5]) S.push({level:4, kind:'scale4', sub:'rim', r, given:'r', ghosts:['GHOST_D_AS_R']});
  // L5 그늘. r=2 제외
  for(const r of [3,4,5]) S.push({level:5, kind:'remain', r, given:'d', ghosts:['GHOST_SWAP','GHOST_NO_SUB']});
  return S;
}
const PLAY_SLOTS = buildPlaySlots();

function makeTask(slot){
  const r=slot.r, d=2*r, C=C100(r), A=A100(r);
  const T={
    id:slot.kind+'-'+r+'-'+(slot.sub||'')+'-'+slot.level,
    kind:slot.kind, sub:slot.sub||'', r0:r, d, C, A,
    rTarget:r, modeTarget:'rim', given:slot.given||'d',
    ghosts:[], prompt:'', targetH:C, targetUnit:'cm',
    unitConcept:'원주 = 지름 × 원주율', formulaMine:'', formulaGood:'',
    missLine:''
  };
  if(slot.kind==='rim'){
    T.modeTarget='rim'; T.rTarget=r; T.targetH=C; T.targetUnit='cm';
    T.prompt = T.given==='d'
      ? '지름이 <b>'+fmtCm(d)+'</b>인 연못 길이야. <b>줄</b>로 막아 줘!'
      : '반지름이 <b>'+fmtCm(r)+'</b>인 길을 <b>줄</b>로 막아 줘!';
    T.formulaGood='둘레 = 지름 × 약 3.14  →  '+fmtCm(d)+' × 약 3.14 = '+fmtLen(C);
    T.unitConcept='원주 = 지름 × 원주율';
    if(slot.ghosts.includes('GHOST_D_AS_R'))
      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:(2*d)*PI100, label:'지름을 반지름처럼'});
    if(slot.ghosts.includes('GHOST_PI_IS_3'))
      T.ghosts.push({misconceptionId:'GHOST_PI_IS_3', r:null, h:d*300, label:'원주율 3'});
  } else if(slot.kind==='fill'){
    T.modeTarget='fill'; T.rTarget=r; T.targetH=A; T.targetUnit='cm²';
    T.prompt='반지름이 <b>'+fmtCm(r)+'</b>인 꽃밭이야. <b>기름 칸</b>으로 채워 줘!';
    T.formulaGood='넓이 = 반지름 × 반지름 × 약 3.14  →  '+r+' × '+r+' × 약 3.14 = '+fmtArea(A);
    T.unitConcept='원의 넓이 = 반지름 × 반지름 × 원주율';
    // GHOST_R_TIMES_TWO: A_ghost = r*2*314 (= C). 칸 카운터 자석
    T.ghosts.push({misconceptionId:'GHOST_R_TIMES_TWO', r:null, h:r*2*PI100, label:'반지름×2'});
    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:C, label:'둘레 값으로 안을 채움', empty:true});
    T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:A100(d), label:'지름을 반지름처럼'});
  } else if(slot.kind==='scale4'){
    const R=2*r;
    T.r0=r;
    if(slot.sub==='rim'){
      T.modeTarget='rim'; T.rTarget=R; T.targetH=C100(R); T.targetUnit='cm';
      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>줄만 2배</b>로 켜 줘!';
      T.formulaGood='줄은 2배 → 반지름도 2배. 둘레 = '+fmtCm(2*R)+' × 약 3.14 = '+fmtLen(C100(R));
      T.unitConcept='원주 = 지름 × 원주율';
      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:2*R, h:C100(2*R), label:'지름을 또 두 배'});
    } else {
      T.modeTarget='fill'; T.rTarget=R; T.targetH=A100(R); T.targetUnit='cm²';
      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>기름을 4배</b>로 켜 줘!';
      T.formulaGood='반지름 2배면 칸은 4배. '+fmtArea(A)+' × 4 = '+fmtArea(A100(R));
      T.unitConcept='반지름이 2배면 넓이는 4배';
      T.ghosts.push({misconceptionId:'GHOST_LINEAR_AREA', r:null, h:2*A, label:'넓이도 2배', stacked:true});
    }
    T.ghosts.push({misconceptionId:'GHOST_OLD', r:r, h:slot.sub==='rim'?C:A, label:'예전 크기', old:true});
  } else {
    T.modeTarget='fill'; T.rTarget=r; T.targetH=remain100(r); T.targetUnit='cm²';
    T.prompt='한 변이 <b>'+fmtCm(d)+'</b>인 꽃밭에서 내접 등잔을 켜고 <b>남은 그늘 칸</b>을 맞춰 줘!';
    T.formulaGood='정사각형 − 원 = '+fmtCm(d)+' × '+fmtCm(d)+' − '+fmtArea(A)+' = '+fmtArea(remain100(r));
    T.unitConcept='색칠한 부분의 넓이';
    T.square=d;
    T.ghosts.push({misconceptionId:'GHOST_NO_SUB', r:null, h:d*d*100, label:'원을 안 뺌'});
    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:d*d*100-C, label:'둘레를 뺌'});
  }
  return T;
}

function liveValue(mode, rInt){
  if(mode==='rim') return {h:C100(rInt), s:fmtLen(C100(rInt))};
  if(mode==='fill') return {h:A100(rInt), s:fmtArea(A100(rInt))};
  return {h:0, s:'—'};
}

function reasonChips(task, g){
  const bank={
    rim:[
      {id:'C_EQ_D_PI', t:'둘레는 지름 × 약 3.14', ok:true},
      {id:'WRONG_PI_EXACT', t:'원주율은 딱 3.14', ok:false},
      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
    ],
    fill:[
      {id:'A_EQ_R2_PI', t:'넓이는 반지름 × 반지름 × 약 3.14', ok:true},
      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false},
      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
    ],
    scale4:[
      {id:'R2_AREA_4X', t:'반지름이 2배면 칸은 4배', ok:true},
      {id:'WRONG_LINEAR', t:'반지름 2배면 넓어도 2배', ok:false},
      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false}
    ],
    remain:[
      {id:'REMAIN', t:'정사각형 넓이에서 원의 넓이를 빼요', ok:true},
      {id:'WRONG_SWAP', t:'정사각형에서 둘레를 빼요', ok:false},
      {id:'WRONG_D_AS_R', t:'원의 넓이는 지름 × 지름 × 약 3.14', ok:false}
    ]
  };
  const k=task.kind==='scale4'?'scale4':task.kind==='remain'?'remain':task.kind==='fill'?'fill':'rim';
  return shuf(g||RNG, bank[k]);
}

function diagnose(task, mode, rInt){
  if(mode!==task.modeTarget){
    return {misconceptionId:'GHOST_SWAP', line:'테두리 줄과 기름 칸을 뒤바꿨어',
      mine: mode==='rim' ? '줄(둘레 공식)로 켰어' : '기름(넓이 공식)으로 켰어',
      good: task.modeTarget==='rim' ? '길은 줄(둘레)로 막아야 해' : '꽃밭은 기름 칸(넓이)으로 채워야 해'};
  }
  const gh=task.ghosts.find(x=>x.r!=null && x.r===rInt && !x.old);
  if(gh) return {misconceptionId:gh.misconceptionId, line:gh.label,
    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
  const val=liveValue(mode,rInt);
  const byH=task.ghosts.find(x=>x.h===val.h && !x.old);
  if(byH) return {misconceptionId:byH.misconceptionId, line:byH.label,
    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
  return {misconceptionId:'MISS_SIZE', line:'크기가 목표와 달라',
    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
}
function playerFormula(task, mode, rInt){
  if(mode==='rim') return '내가 켠 줄 = 지름 '+fmtCm(2*rInt)+' × 약 3.14 = '+fmtLen(C100(rInt));
  return '내가 켠 칸 = '+rInt+' × '+rInt+' × 약 3.14 = '+fmtArea(A100(rInt));
}

