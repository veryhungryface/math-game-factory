const IM = {};
function punchWhite(im){
  try{
    const c=document.createElement('canvas');
    c.width=im.naturalWidth||im.width; c.height=im.naturalHeight||im.height;
    const x=c.getContext('2d'); x.drawImage(im,0,0);
    const id=x.getImageData(0,0,c.width,c.height), d=id.data;
    for(let i=0;i<d.length;i+=4){
      const r=d[i],g=d[i+1],b=d[i+2];
      if(r>248&&g>248&&b>248) d[i+3]=0;
      else if(r>236&&g>236&&b>236){
        const t=(r+g+b-708)/60;
        d[i+3]=Math.round(d[i+3]*Math.max(0,1-t));
      }
    }
    x.putImageData(id,0,0); return c;
  }catch(e){ return im; }
}
function loadImg(key, src, punch){
  return new Promise(res=>{
    const im=new Image();
    im.onload=()=>{ IM[key]=punch?punchWhite(im):im; res(); };
    im.onerror=()=>{ IM[key]=null; res(); };
    im.src=src;
  });
}

let AC=null, muted=false, bgGain=null, bgOsc=[];
function ensureAudio(){
  if(!AC){
    const C=window.AudioContext||window.webkitAudioContext;
    if(!C) return;
    AC=new C();
  }
  if(AC.state==='suspended') AC.resume();
}
function beep(freq, dur, type, vol){
  if(muted||!AC) return;
  const t=AC.currentTime;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type=type||'sine'; o.frequency.setValueAtTime(freq, t);
  g.gain.setValueAtTime(Math.max(0.0001, vol||0.07), t);
  g.gain.exponentialRampToValueAtTime(0.0001, t+dur);
  o.connect(g); g.connect(AC.destination);
  o.start(t); o.stop(t+dur);
}
function sfxCorrect(combo){
  ensureAudio();
  beep(523, 0.12, 'triangle', 0.08);
  beep(784, 0.18, 'sine', 0.06);
  if(combo>=3) beep(1046, 0.22, 'triangle', 0.05);
  if(combo>=6) beep(1318, 0.28, 'sine', 0.04);
  if(combo>=10) beep(1568, 0.32, 'triangle', 0.035);
}
function sfxWrong(){ ensureAudio(); beep(180, 0.22, 'sawtooth', 0.06); beep(110, 0.3, 'square', 0.04); }
function sfxTick(){ ensureAudio(); beep(660, 0.05, 'sine', 0.03); }
function sfxSnap(){ ensureAudio(); beep(440, 0.08, 'triangle', 0.05); }

function setMuted(v){
  muted=!!v;
  const icon=muted?'🔇':'🔊';
  $('muteBtn').textContent=icon; $('titleMute').textContent=icon;
