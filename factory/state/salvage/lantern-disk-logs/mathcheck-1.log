   600	/* ── 플레이 슬롯 풀 (전수, 제약 만족) ───────────────────── */
   601	function buildPlaySlots(){
   602	  const S=[];
   603	  // L1 둘레 길. r∈{2,5,10} 림만. 고스트 없음
   604	  for(const r of [2,5,10]) S.push({level:1, kind:'rim', r, given:'d', ghosts:[]});
   605	  // L2 지름 표지판. GHOST_D_AS_R
   606	  for(const r of [3,4,5]) S.push({level:2, kind:'rim', r, given:'d', ghosts:['GHOST_D_AS_R','GHOST_PI_IS_3']});
   607	  // L3 꽃밭. r=2 제외(제곱=두 배). GHOST_R_TIMES_TWO + GHOST_SWAP
   608	  for(const r of [4,5,10]) S.push({level:3, kind:'fill', r, given:'r', ghosts:['GHOST_R_TIMES_TWO','GHOST_SWAP','GHOST_D_AS_R']});
   609	  // L4 두 배
   610	  for(const r of [2,4,5]) S.push({level:4, kind:'scale4', sub:'fill', r, given:'r', ghosts:['GHOST_LINEAR_AREA']});
   611	  for(const r of [2,5]) S.push({level:4, kind:'scale4', sub:'rim', r, given:'r', ghosts:['GHOST_D_AS_R']});
   612	  // L5 그늘. r=2 제외
   613	  for(const r of [3,4,5]) S.push({level:5, kind:'remain', r, given:'d', ghosts:['GHOST_SWAP','GHOST_NO_SUB']});
   614	  return S;
   615	}
   616	const PLAY_SLOTS = buildPlaySlots();
   617	
   618	function makeTask(slot){
   619	  const r=slot.r, d=2*r, C=C100(r), A=A100(r);
   620	  const T={
   621	    id:slot.kind+'-'+r+'-'+(slot.sub||'')+'-'+slot.level,
   622	    kind:slot.kind, sub:slot.sub||'', r0:r, d, C, A,
   623	    rTarget:r, modeTarget:'rim', given:slot.given||'d',
   624	    ghosts:[], prompt:'', targetH:C, targetUnit:'cm',
   625	    unitConcept:'원주 = 지름 × 원주율', formulaMine:'', formulaGood:'',
   626	    missLine:''
   627	  };
   628	  if(slot.kind==='rim'){
   629	    T.modeTarget='rim'; T.rTarget=r; T.targetH=C; T.targetUnit='cm';
   630	    T.prompt = T.given==='d'
   631	      ? '지름이 <b>'+fmtCm(d)+'</b>인 연못 길이야. <b>줄</b>로 막아 줘!'
   632	      : '반지름이 <b>'+fmtCm(r)+'</b>인 길을 <b>줄</b>로 막아 줘!';
   633	    T.formulaGood='둘레 = 지름 × 약 3.14  →  '+fmtCm(d)+' × 약 3.14 = '+fmtLen(C);
   634	    T.unitConcept='원주 = 지름 × 원주율';
   635	    if(slot.ghosts.includes('GHOST_D_AS_R'))
   636	      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:(2*d)*PI100, label:'지름을 반지름처럼'});
   637	    if(slot.ghosts.includes('GHOST_PI_IS_3'))
   638	      T.ghosts.push({misconceptionId:'GHOST_PI_IS_3', r:null, h:d*300, label:'원주율 3'});
   639	  } else if(slot.kind==='fill'){
   640	    T.modeTarget='fill'; T.rTarget=r; T.targetH=A; T.targetUnit='cm²';
   641	    T.prompt='반지름이 <b>'+fmtCm(r)+'</b>인 꽃밭이야. <b>기름 칸</b>으로 채워 줘!';
   642	    T.formulaGood='넓이 = 반지름 × 반지름 × 약 3.14  →  '+r+' × '+r+' × 약 3.14 = '+fmtArea(A);
   643	    T.unitConcept='원의 넓이 = 반지름 × 반지름 × 원주율';
   644	    // GHOST_R_TIMES_TWO: A_ghost = r*2*314 (= C). 칸 카운터 자석
   645	    T.ghosts.push({misconceptionId:'GHOST_R_TIMES_TWO', r:null, h:r*2*PI100, label:'반지름×2'});
   646	    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:C, label:'둘레 값으로 안을 채움', empty:true});
   647	    T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:A100(d), label:'지름을 반지름처럼'});
   648	  } else if(slot.kind==='scale4'){
   649	    const R=2*r;
   650	    T.r0=r;
   651	    if(slot.sub==='rim'){
   652	      T.modeTarget='rim'; T.rTarget=R; T.targetH=C100(R); T.targetUnit='cm';
   653	      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>줄만 2배</b>로 켜 줘!';
   654	      T.formulaGood='줄은 2배 → 반지름도 2배. 둘레 = '+fmtCm(2*R)+' × 약 3.14 = '+fmtLen(C100(R));
   655	      T.unitConcept='원주 = 지름 × 원주율';
   656	      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:2*R, h:C100(2*R), label:'지름을 또 두 배'});
   657	    } else {
   658	      T.modeTarget='fill'; T.rTarget=R; T.targetH=A100(R); T.targetUnit='cm²';
   659	      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>기름을 4배</b>로 켜 줘!';
   660	      T.formulaGood='반지름 2배면 칸은 4배. '+fmtArea(A)+' × 4 = '+fmtArea(A100(R));
   661	      T.unitConcept='반지름이 2배면 넓이는 4배';
   662	      T.ghosts.push({misconceptionId:'GHOST_LINEAR_AREA', r:null, h:2*A, label:'넓이도 2배', stacked:true});
   663	    }
   664	    T.ghosts.push({misconceptionId:'GHOST_OLD', r:r, h:slot.sub==='rim'?C:A, label:'예전 크기', old:true});
   665	  } else {
   666	    T.modeTarget='fill'; T.rTarget=r; T.targetH=remain100(r); T.targetUnit='cm²';
   667	    T.prompt='한 변이 <b>'+fmtCm(d)+'</b>인 꽃밭에서 내접 등잔을 켜고 <b>남은 그늘 칸</b>을 맞춰 줘!';
   668	    T.formulaGood='정사각형 − 원 = '+fmtCm(d)+' × '+fmtCm(d)+' − '+fmtArea(A)+' = '+fmtArea(remain100(r));
   669	    T.unitConcept='색칠한 부분의 넓이';
   670	    T.square=d;
   671	    T.ghosts.push({misconceptionId:'GHOST_NO_SUB', r:null, h:d*d*100, label:'원을 안 뺌'});
   672	    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:d*d*100-C, label:'둘레를 뺌'});
   673	  }
   674	  return T;
   675	}
   676	
   677	function liveValue(mode, rInt){
   678	  if(mode==='rim') return {h:C100(rInt), s:fmtLen(C100(rInt))};
   679	  if(mode==='fill') return {h:A100(rInt), s:fmtArea(A100(rInt))};
   680	  return {h:0, s:'—'};
   681	}
