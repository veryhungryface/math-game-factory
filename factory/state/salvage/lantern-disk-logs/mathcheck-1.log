  1073	  if(S.sprint){
  1074	    toast('콤보가 끊겼어. 다시 켜 봐!', 'bad');
  1075	    S.lockInput=false;
  1076	    showCompare(diag, true);
  1077	    return;
  1078	  }
  1079	  if(!S.hard && S.missOnTask===1 && task && S.mode===task.modeTarget && Math.abs(rInt-task.rTarget)<=1){
  1080	    S.lives=Math.min(3, S.lives+1); // 1차 근접 힌트는 목숨 회복
  1081	    setScoreUI();
  1082	    toast('거의 맞았어. 1 cm만 더 맞춰 봐!', 'bad');
  1083	    S.lockInput=false;
  1084	    return;
