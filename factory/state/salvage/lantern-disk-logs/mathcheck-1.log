};

function comboMul(c){ return c>=4?5:c>=3?3:c>=2?2:1; }
function lanternTier(){ const c=S.combo; return c>=10?3:c>=6?2:c>=3?1:0; }

function layout(){
  W=innerWidth; H=innerHeight; DPR=Math.min(devicePixelRatio||1,2);
  cv.width=Math.floor(W*DPR); cv.height=Math.floor(H*DPR);
  cv.style.width=W+'px'; cv.style.height=H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
  S.land = W>H && W>=640;
  document.documentElement.classList.toggle('land', S.land);
  const top = 132 + (parseInt(getComputedStyle(document.documentElement).fontSize)||16);
  const bot = 148;
  const y0 = Math.max(118, 108 + (S.phase==='playing'?8:0));
  const y1 = H - bot;
  S.play = {x:0, y:y0, w:W, h:Math.max(160, y1-y0)};
  if(S.land){
    S.play = {x:0, y:72, w:W*0.58, h:H-88};
  }
  const fit = Math.min(S.play.w, S.play.h);
  S.px = clamp(fit*0.36/10, 14, 28);
  S.lx = S.play.x + S.play.w*0.5;
  S.ly = S.play.y + S.play.h*0.52;
}

function rpx(r){ return r * S.px; }

function populateHearts(){
  const h=$('hearts'); h.innerHTML='';
  for(let i=0;i<3;i++){
    const s=document.createElement('canvas'); s.width=36; s.height=36; s.className='hp'+(i>=S.lives?' off':'');
    const x=s.getContext('2d'); x.fillStyle='#E24A2A';
    x.beginPath(); x.moveTo(18,30); x.bezierCurveTo(4,20,4,10,18,14); x.bezierCurveTo(32,10,32,20,18,30); x.fill();
    h.appendChild(s);
  }
}
