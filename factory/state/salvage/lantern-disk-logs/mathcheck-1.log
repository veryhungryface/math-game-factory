   683	function reasonChips(task, g){
   684	  const bank={
   685	    rim:[
   686	      {id:'C_EQ_D_PI', t:'둘레는 지름 × 약 3.14', ok:true},
   687	      {id:'WRONG_PI_EXACT', t:'원주율은 딱 3.14', ok:false},
   688	      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
   689	    ],
   690	    fill:[
   691	      {id:'A_EQ_R2_PI', t:'넓이는 반지름 × 반지름 × 약 3.14', ok:true},
   692	      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false},
   693	      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
   694	    ],
   695	    scale4:[
   696	      {id:'R2_AREA_4X', t:'반지름이 2배면 칸은 4배', ok:true},
   697	      {id:'WRONG_LINEAR', t:'반지름 2배면 넓어도 2배', ok:false},
   698	      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false}
   699	    ],
   700	    remain:[
   701	      {id:'REMAIN', t:'정사각형 넓이에서 원의 넓이를 빼요', ok:true},
   702	      {id:'WRONG_SWAP', t:'정사각형에서 둘레를 빼요', ok:false},
   703	      {id:'WRONG_D_AS_R', t:'원의 넓이는 지름 × 지름 × 약 3.14', ok:false}
   704	    ]
   705	  };
   706	  const k=task.kind==='scale4'?'scale4':task.kind==='remain'?'remain':task.kind==='fill'?'fill':'rim';
   707	  return shuf(g||RNG, bank[k]);
   708	}
   709	
   710	function diagnose(task, mode, rInt){
   711	  if(mode!==task.modeTarget){
   712	    return {misconceptionId:'GHOST_SWAP', line:'테두리 줄과 기름 칸을 뒤바꿨어',
   713	      mine: mode==='rim' ? '줄(둘레 공식)로 켰어' : '기름(넓이 공식)으로 켰어',
   714	      good: task.modeTarget==='rim' ? '길은 줄(둘레)로 막아야 해' : '꽃밭은 기름 칸(넓이)으로 채워야 해'};
   715	  }
   716	  const gh=task.ghosts.find(x=>x.r!=null && x.r===rInt && !x.old);
   717	  if(gh) return {misconceptionId:gh.misconceptionId, line:gh.label,
   718	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   719	  const val=liveValue(mode,rInt);
   720	  const byH=task.ghosts.find(x=>x.h===val.h && !x.old);
   721	  if(byH) return {misconceptionId:byH.misconceptionId, line:byH.label,
   722	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   723	  return {misconceptionId:'MISS_SIZE', line:'크기가 목표와 달라',
   724	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   725	}
   726	function playerFormula(task, mode, rInt){
   727	  if(mode==='rim') return '내가 켠 줄 = 지름 '+fmtCm(2*rInt)+' × 약 3.14 = '+fmtLen(C100(rInt));
