   572	  }
   573	  // 식별(계산 없음)
   574	  P.push({id:'id-rim', prompt:'나방이 원 둘레 길을 걸어요. 등잔을 어떻게 켤까요?',
   575	    choices:shuf(g,['테두리에 줄을 두른다','안을 기름 칸으로 채운다','지름 숫자만 켠다','원주율만 켠다']),
   576	    answer:'테두리에 줄을 두른다', answerNumeric:1, unitConcept:'원주'});
   577	  P.push({id:'id-fill', prompt:'나방이 원 안 꽃밭에 앉아요. 등잔을 어떻게 켤까요?',
