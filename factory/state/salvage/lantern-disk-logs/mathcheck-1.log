   579	    answer:'안을 기름 칸으로 채운다', answerNumeric:2, unitConcept:'원의 넓이'});
   580	  P.push({id:'id-pi', prompt:'계산에서 쓰는 3.14에 대한 설명으로 옳은 것은?',
   581	    choices:shuf(g,['3.14는 원주율의 근삿값이다','원주율은 딱 3.14이다','원주율은 3이다','원주율은 지름이다']),
   582	    answer:'3.14는 원주율의 근삿값이다', answerNumeric:3.14, unitConcept:'원주율(근삿값 3.14)'});
   583	  P.push({id:'id-contract', prompt:'이 등잔에서 둘레와 넓이를 바르게 짝지은 것은?',
   584	    choices:shuf(g,['줄 길이=둘레, 칸 수=넓이','줄 길이=넓이, 칸 수=둘레','지름=넓이, 반지름=둘레','원주율=넓이']),
   585	    answer:'줄 길이=둘레, 칸 수=넓이', answerNumeric:1, unitConcept:'원주와 넓이 구별'});
   586	  return P;
   587	}
   588	const MC_POOL = buildMcPool();
   589	
   590	function sampleProblems(n){
   591	  const g=mulberry32(0xA11CE);
   592	  const seen=new Set(), uniq=[];
   593	  for(const p of shuf(g, MC_POOL)){
   594	    if(seen.has(p.prompt)) continue;
   595	    seen.add(p.prompt); uniq.push(p);
   596	  }
   597	  return uniq.slice(0, Math.max(1, n|0));
   598	}
