  1019	function applyCorrect(fromTest){
  1020	  const task=S.task;
  1021	  S.combo++;
  1022	  if(S.combo>S.bestCombo) S.bestCombo=S.combo;
  1023	  const add=100*comboMul(S.combo) + 50;
  1024	  S.score += add;
  1025	  S.solved++;
  1026	  if(S.lives<3) S.lives++;
  1027	  S.lockInput=true;
  1028	  S.rFloat=task?task.rTarget:S.rFloat; S.rVis=S.rFloat;
  1029	  if(task) S.mode=task.modeTarget;
  1030	  setScoreUI(); punchScore();
  1031	  // 정답 어휘: 상승·확산·빛. 흔들림 금지
  1032	  hitStop(task && task.kind==='scale4'?90:70);
  1033	  squash(0.86, 1.18);
  1034	  flash('#F2C14E', 0.42);
  1035	  const n=18+Math.min(40, S.combo*6);
  1036	  burst(S.lx, S.ly, n, ['#F2C14E','#E24A2A','#fff6c4','#ffe08a'], true);
  1037	  sfxCorrect(S.combo);
  1038	  praise(S.combo>=5?'줄 2배 · 칸 4배!': S.combo>=3?'환하게 켜졌어!':'점등!');
  1039	  S.moths.forEach(m=>m.glow=1);
  1040	  saveDex(task);
  1041	  updateValues();
  1042	  const best=Number(localStorage.getItem(LS_BEST)||0);
  1043	  if(S.score>best) localStorage.setItem(LS_BEST, String(S.score));
  1044	  if(S.bestCombo>Number(localStorage.getItem(LS_COMBO)||0)) localStorage.setItem(LS_COMBO, String(S.bestCombo));
  1045	
  1046	  if(S.sprint || fromTest){
  1047	    setTimeout(()=>{ S.qIdx++; S.lockInput=false; if(S.phase==='playing') nextTask(); }, fromTest?30:650);
  1048	    return;
  1049	  }
  1050	  setTimeout(()=>showReasons(), 520);
  1051	}
  1052	
  1053	function applyWrong(fromTest){
  1054	  const task=S.task;
  1055	  const rInt=Math.round(S.rFloat);
  1056	  const diag=task?diagnose(task, S.mode, rInt):{misconceptionId:'MISS', line:'빗나감', mine:'?', good:'?'};
  1057	  S.combo=0;
  1058	  S.lives=Math.max(0, S.lives-1);
