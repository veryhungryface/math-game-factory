   443	function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);
   444	  t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296}}
   445	const RNG = mulberry32((Date.now() ^ 0xC14C1E) >>> 0);
   446	function shuf(g, a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(g()*(i+1));const t=a[i];a[i]=a[j];a[j]=t}return a}
   447	function clamp(v,a,b){return v<a?a:v>b?b:v}
   448	function lerp(a,b,t){return a+(b-a)*t}
   449	function fmt(h){
   450	  const neg=h<0; h=Math.abs(Math.round(h));
   451	  const i=Math.floor(h/100), f=h%100;
   452	  let s;
   453	  if(f===0) s=String(i);
   454	  else if(f%10===0) s=i+'.'+(f/10);
   455	  else s=i+'.'+String(f).padStart(2,'0');
   456	  return (neg?'-':'')+s;
   457	}
   458	function fmtCm(n){return n+' cm'}
   459	function fmtLen(h){return fmt(h)+' cm'}
   460	function fmtArea(h){return fmt(h)+' cm²'}
   461	function C100(r){return 2*r*PI100}
   462	function A100(r){return r*r*PI100}
   463	function remain100(r){const d=2*r; return d*d*100 - r*r*PI100}
   464	
   465	/**
   466	 * 오답 후처리: 정답 제거 → 범위 검사 → 중복 제거 → 부족분 보충 → 셔플
   467	 * cands[].misconceptionId 는 오개념 역산 표식 (검산관 확인용)
   468	 */
   469	function pickChoices(correctStr, cands, extras, g){
   470	  const seen=new Set([String(correctStr)]);
   471	  const dist=[];
   472	  const add=(c)=>{
   473	    if(!c||c.s==null) return;
   474	    const s=String(c.s);
   475	    if(!s||seen.has(s)) return;
   476	    if(c.ok===false) return;
   477	    seen.add(s); dist.push(s);
   478	  };
   479	  for(const c of cands) add(c);
   480	  if(extras) for(const c of extras){ if(dist.length>=3) break; add(c); }
   481	  let k=1;
   482	  while(dist.length<3 && k<40){
   483	    const s=String(correctStr).replace(/[\d.]+/, (n)=>{
   484	      const v=Math.round(Number(n)*100)+k*100; k++; return fmt(v);
   485	    });
   486	    k++;
   487	    if(!seen.has(s) && s!==String(correctStr)){ seen.add(s); dist.push(s); }
   488	  }
   489	  return shuf(g||RNG, [String(correctStr)].concat(dist.slice(0,3)));
   490	}
