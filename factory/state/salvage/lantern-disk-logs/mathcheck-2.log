   627	function buildPlaySlots(){
   628	  const S=[];
   629	  // L1 둘레 길. r∈{2,5,10} 림만. 고스트 없음
   630	  for(const r of [2,5,10]) S.push({level:1, kind:'rim', r, given:'d', ghosts:[]});
   631	  // L2 지름 표지판. GHOST_D_AS_R
   632	  for(const r of [3,4,5]) S.push({level:2, kind:'rim', r, given:'d', ghosts:['GHOST_D_AS_R','GHOST_PI_IS_3']});
   633	  // L3 꽃밭. r=2 제외(제곱=두 배). GHOST_R_TIMES_TWO + GHOST_SWAP
   634	  for(const r of [4,5,10]) S.push({level:3, kind:'fill', r, given:'r', ghosts:['GHOST_R_TIMES_TWO','GHOST_SWAP','GHOST_D_AS_R']});
   635	  // L4 두 배
   636	  for(const r of [2,4,5]) S.push({level:4, kind:'scale4', sub:'fill', r, given:'r', ghosts:['GHOST_LINEAR_AREA']});
   637	  for(const r of [2,5]) S.push({level:4, kind:'scale4', sub:'rim', r, given:'r', ghosts:['GHOST_D_AS_R']});
   638	  // L5 그늘. r=2 제외
   639	  for(const r of [3,4,5]) S.push({level:5, kind:'remain', r, given:'d', ghosts:['GHOST_SWAP','GHOST_NO_SUB']});
   640	  return S;
   641	}
