   431	   정수 백분위 모델. PI100=314. 부동소수점 비교 금지.
   432	   C100 = d * 314    A100 = r * r * 314
   433	   remain100 = d*d*100 - r*r*314
   434	   ════════════════════════════════════════════════════════════ */
   435	const PI100 = 314;
   436	const LS_BEST = 'lantern-disk:best';
   437	const LS_COMBO = 'lantern-disk:bestCombo';
   438	const LS_ONB = 'onboardingSeen:lantern-disk';
