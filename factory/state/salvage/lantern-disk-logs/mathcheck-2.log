   736	function diagnose(task, mode, rInt){
   737	  if(mode!==task.modeTarget){
   738	    return {misconceptionId:'GHOST_SWAP', line:'테두리 줄과 기름 칸을 뒤바꿨어',
   739	      mine: mode==='rim' ? '줄(둘레 공식)로 켰어' : '기름(넓이 공식)으로 켰어',
   740	      good: task.modeTarget==='rim' ? '길은 줄(둘레)로 막아야 해' : '꽃밭은 기름 칸(넓이)으로 채워야 해'};
   741	  }
   742	  const gh=task.ghosts.find(x=>x.r!=null && x.r===rInt && !x.old);
   743	  if(gh) return {misconceptionId:gh.misconceptionId, line:gh.label,
   744	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   745	  const val=liveValue(mode,rInt);
   746	  const byH=task.ghosts.find(x=>x.h===val.h && !x.old);
   747	  if(byH) return {misconceptionId:byH.misconceptionId, line:byH.label,
   748	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   749	  return {misconceptionId:'MISS_SIZE', line:'크기가 목표와 달라',
   750	    mine: playerFormula(task, mode, rInt), good: task.formulaGood};
   751	}
   752	function playerFormula(task, mode, rInt){
   753	  if(mode==='rim') return '내가 켠 줄 = 지름 '+fmtCm(2*rInt)+' × 약 3.14 = '+fmtLen(C100(rInt));
   754	  return '내가 켠 칸 = '+rInt+' × '+rInt+' × 약 3.14 = '+fmtArea(A100(rInt));
   755	}
