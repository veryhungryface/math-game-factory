   709	function reasonChips(task, g){
   710	  const bank={
   711	    rim:[
   712	      {id:'C_EQ_D_PI', t:'둘레는 지름 × 약 3.14', ok:true},
   713	      {id:'WRONG_PI_EXACT', t:'원주율은 딱 3.14', ok:false},
   714	      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
   715	    ],
   716	    fill:[
   717	      {id:'A_EQ_R2_PI', t:'넓이는 반지름 × 반지름 × 약 3.14', ok:true},
   718	      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false},
   719	      {id:'WRONG_D_AS_R', t:'지름을 그대로 곱하면 된다', ok:false}
   720	    ],
   721	    scale4:[
   722	      {id:'R2_AREA_4X', t:'반지름이 2배면 칸은 4배', ok:true},
   723	      {id:'WRONG_LINEAR', t:'반지름 2배면 넓어도 2배', ok:false},
   724	      {id:'WRONG_SWAP', t:'둘레 값으로 안을 채운다', ok:false}
   725	    ],
   726	    remain:[
   727	      {id:'REMAIN', t:'정사각형 넓이에서 원의 넓이를 빼요', ok:true},
   728	      {id:'WRONG_SWAP', t:'정사각형에서 둘레를 빼요', ok:false},
   729	      {id:'WRONG_D_AS_R', t:'원의 넓이는 지름 × 지름 × 약 3.14', ok:false}
   730	    ]
   731	  };
   732	  const k=task.kind==='scale4'?'scale4':task.kind==='remain'?'remain':task.kind==='fill'?'fill':'rim';
   733	  return shuf(g||RNG, bank[k]);
   734	}
