  1521	function drawLantern(){
  1522	  const r=S.rVis, rp=rpx(r);
  1523	  ctx.save();
  1524	  ctx.translate(S.lx, S.ly);
  1525	  ctx.scale(S.sqX, S.sqY);
  1526	  ctx.translate(-S.lx, -S.ly);
  1527	
  1528	  // 그림자
  1529	  ctx.fillStyle='rgba(28,36,34,0.35)';
  1530	  ctx.beginPath(); ctx.ellipse(S.lx+6, S.ly+rp*0.72, rp*0.7, rp*0.16, 0, 0, Math.PI*2); ctx.fill();
  1531	
  1532	  if(S.task && S.task.kind==='remain') drawSquareBed(S.task, rp);
  1533	  drawGhosts(S.task);
  1534	
  1535	  // 종이 등피
  1536	  ctx.save(); ctx.translate(S.lx,S.ly);
  1537	  const grd=ctx.createRadialGradient(-rp*0.25,-rp*0.25, rp*0.1, 0,0,rp);
  1538	  grd.addColorStop(0,'#fff3c8'); grd.addColorStop(0.55,'#f0c35a'); grd.addColorStop(1,'#c45a2c');
  1539	  ctx.fillStyle=grd;
  1540	  ctx.beginPath(); ctx.arc(0,0,rp,0,Math.PI*2); ctx.fill();
  1541	  ctx.restore();
  1542	
  1543	  if(IM.hero){
  1544	    ctx.save();
  1545	    ctx.beginPath(); ctx.arc(S.lx,S.ly,rp-1,0,Math.PI*2); ctx.clip();
  1546	    ctx.globalAlpha=0.55;
  1547	    ctx.drawImage(IM.hero, S.lx-rp, S.ly-rp, rp*2, rp*2);
  1548	    ctx.restore();
  1549	  }
  1550	
  1551	  const showTiles = S.mode==='fill' || (S.task && S.task.modeTarget==='fill' && S.mode!=='rim');
  1552	  if(showTiles) drawTiles(rp, S.mode==='fill'?0.95:0.55);
  1553	
  1554	  // 림 줄
  1555	  ctx.save(); ctx.translate(S.lx,S.ly);
  1556	  const wrap = S.mode==='rim' ? 1 : 0.35;
  1557	  ctx.strokeStyle=`rgba(226,74,42,${0.55+0.45*wrap})`;
  1558	  ctx.lineWidth=Math.max(6, rp*0.07);
  1559	  ctx.lineCap='round';
  1560	  ctx.beginPath(); ctx.arc(0,0,rp, -Math.PI/2, -Math.PI/2 + Math.PI*2*wrap); ctx.stroke();
  1561	  // 눈금
  1562	  ctx.strokeStyle='#fff6e2'; ctx.lineWidth=2;
  1563	  const ticks=Math.max(8, Math.round(2*r));
  1564	  for(let i=0;i<ticks;i++){
  1565	    const a=-Math.PI/2 + i/ticks*Math.PI*2*wrap;
  1566	    ctx.beginPath(); ctx.moveTo(Math.cos(a)*(rp-5), Math.sin(a)*(rp-5));
  1567	    ctx.lineTo(Math.cos(a)*(rp+5), Math.sin(a)*(rp+5)); ctx.stroke();
  1568	  }
  1569	  // 손잡이 고리
  1570	  ctx.fillStyle='#E24A2A';
  1571	  ctx.beginPath(); ctx.arc(0, -rp, 11, 0, Math.PI*2); ctx.fill();
  1572	  ctx.strokeStyle='#1C2422'; ctx.lineWidth=2; ctx.stroke();
  1573	  ctx.restore();
  1574	
  1575	  // 콤보 무늬
  1576	  const tier=lanternTier();
  1577	  if(tier>0){
  1578	    ctx.save(); ctx.translate(S.lx,S.ly);
  1579	    ctx.strokeStyle=`rgba(255,246,196,${0.25+tier*0.15})`; ctx.lineWidth=1.5;
  1580	    for(let k=1;k<=tier;k++){
  1581	      ctx.beginPath(); ctx.arc(0,0, rp*(0.35+k*0.15), 0, Math.PI*2); ctx.stroke();
  1582	    }
  1583	    ctx.restore();
  1584	  }
  1585	
  1586	  // 림 히트 링 힌트
  1587	  if(S.phase==='playing' && !S.mode){
  1588	    ctx.save(); ctx.translate(S.lx,S.ly);
  1589	    ctx.strokeStyle='rgba(226,74,42,0.35)'; ctx.lineWidth=10;
  1590	    ctx.beginPath(); ctx.arc(0,0,rp,0,Math.PI*2); ctx.stroke();
  1591	    ctx.fillStyle='rgba(242,193,78,0.18)';
  1592	    ctx.beginPath(); ctx.arc(0,0,rp*0.5,0,Math.PI*2); ctx.fill();
  1593	    ctx.restore();
  1594	  }
  1595	  ctx.restore();
  1596	}
