   765	const IM = {};
   766	function punchWhite(im){
   767	  try{
   768	    const c=document.createElement('canvas');
   769	    c.width=im.naturalWidth||im.width; c.height=im.naturalHeight||im.height;
   770	    const x=c.getContext('2d'); x.drawImage(im,0,0);
   771	    const id=x.getImageData(0,0,c.width,c.height), d=id.data;
   772	    for(let i=0;i<d.length;i+=4){
   773	      const r=d[i],g=d[i+1],b=d[i+2];
   774	      if(r>248&&g>248&&b>248) d[i+3]=0;
   775	      else if(r>236&&g>236&&b>236){
   776	        const t=(r+g+b-708)/60;
   777	        d[i+3]=Math.round(d[i+3]*Math.max(0,1-t));
   778	      }
   779	    }
   780	    x.putImageData(id,0,0); return c;
   781	  }catch(e){ return im; }
   782	}
   783	function loadImg(key, src, punch){
   784	  return new Promise(res=>{
   785	    const im=new Image();
   786	    im.onload=()=>{ IM[key]=punch?punchWhite(im):im; res(); };
   787	    im.onerror=()=>{ IM[key]=null; res(); };
   788	    im.src=src;
   789	  });
   790	}
  1450	  }
  1451	}
