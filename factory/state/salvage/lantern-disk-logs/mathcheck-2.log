   649	    rTarget:r, modeTarget:'rim', given:slot.given||'d',
   650	    ghosts:[], prompt:'', targetH:C, targetUnit:'cm',
   651	    unitConcept:'원주 = 지름 × 원주율', formulaMine:'', formulaGood:'',
   652	    missLine:''
   653	  };
   654	  if(slot.kind==='rim'){
   655	    T.modeTarget='rim'; T.rTarget=r; T.targetH=C; T.targetUnit='cm';
   656	    T.prompt = T.given==='d'
   657	      ? '지름이 <b>'+fmtCm(d)+'</b>인 연못 길이야. <b>줄</b>로 막아 줘!'
   658	      : '반지름이 <b>'+fmtCm(r)+'</b>인 길을 <b>줄</b>로 막아 줘!';
   659	    T.formulaGood='둘레 = 지름 × 약 3.14  →  '+fmtCm(d)+' × 약 3.14 = '+fmtLen(C);
   660	    T.unitConcept='원주 = 지름 × 원주율';
   661	    if(slot.ghosts.includes('GHOST_D_AS_R'))
   662	      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:(2*d)*PI100, label:'지름을 반지름처럼'});
   663	    if(slot.ghosts.includes('GHOST_PI_IS_3'))
   664	      T.ghosts.push({misconceptionId:'GHOST_PI_IS_3', r:null, h:d*300, label:'원주율 3'});
   665	  } else if(slot.kind==='fill'){
   666	    T.modeTarget='fill'; T.rTarget=r; T.targetH=A; T.targetUnit='cm²';
   667	    T.prompt='반지름이 <b>'+fmtCm(r)+'</b>인 꽃밭이야. <b>기름 칸</b>으로 채워 줘!';
   668	    T.formulaGood='넓이 = 반지름 × 반지름 × 약 3.14  →  '+r+' × '+r+' × 약 3.14 = '+fmtArea(A);
   669	    T.unitConcept='원의 넓이 = 반지름 × 반지름 × 원주율';
   670	    // GHOST_R_TIMES_TWO: A_ghost = r*2*314 (= C). 칸 카운터 자석
   671	    T.ghosts.push({misconceptionId:'GHOST_R_TIMES_TWO', r:null, h:r*2*PI100, label:'반지름×2'});
   672	    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:C, label:'둘레 값으로 안을 채움', empty:true});
   673	    T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:d, h:A100(d), label:'지름을 반지름처럼'});
   674	  } else if(slot.kind==='scale4'){
   675	    const R=2*r;
   676	    T.r0=r;
   677	    if(slot.sub==='rim'){
   678	      T.modeTarget='rim'; T.rTarget=R; T.targetH=C100(R); T.targetUnit='cm';
   679	      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>줄만 2배</b>로 켜 줘!';
   680	      T.formulaGood='줄은 2배 → 반지름도 2배. 둘레 = '+fmtCm(2*R)+' × 약 3.14 = '+fmtLen(C100(R));
   681	      T.unitConcept='원주 = 지름 × 원주율';
   682	      T.ghosts.push({misconceptionId:'GHOST_D_AS_R', r:2*R, h:C100(2*R), label:'지름을 또 두 배'});
   683	    } else {
   684	      T.modeTarget='fill'; T.rTarget=R; T.targetH=A100(R); T.targetUnit='cm²';
   685	      T.prompt='지금 등잔(반지름 <b>'+fmtCm(r)+'</b>)의 <b>기름을 4배</b>로 켜 줘!';
   686	      T.formulaGood='반지름 2배면 칸은 4배. '+fmtArea(A)+' × 4 = '+fmtArea(A100(R));
   687	      T.unitConcept='반지름이 2배면 넓이는 4배';
   688	      T.ghosts.push({misconceptionId:'GHOST_LINEAR_AREA', r:null, h:2*A, label:'넓이도 2배', stacked:true});
   689	    }
   690	    T.ghosts.push({misconceptionId:'GHOST_OLD', r:r, h:slot.sub==='rim'?C:A, label:'예전 크기', old:true});
   691	  } else {
   692	    T.modeTarget='fill'; T.rTarget=r; T.targetH=remain100(r); T.targetUnit='cm²';
   693	    T.prompt='한 변이 <b>'+fmtCm(d)+'</b>인 꽃밭에서 내접 등잔을 켜고 <b>남은 그늘 칸</b>을 맞춰 줘!';
   694	    T.formulaGood='정사각형 − 원 = '+fmtCm(d)+' × '+fmtCm(d)+' − '+fmtArea(A)+' = '+fmtArea(remain100(r));
   695	    T.unitConcept='색칠한 부분의 넓이';
   696	    T.square=d;
   697	    T.ghosts.push({misconceptionId:'GHOST_NO_SUB', r:null, h:d*d*100, label:'원을 안 뺌'});
   698	    T.ghosts.push({misconceptionId:'GHOST_SWAP', r:null, h:d*d*100-C, label:'둘레를 뺌'});
   699	  }
   700	  return T;
