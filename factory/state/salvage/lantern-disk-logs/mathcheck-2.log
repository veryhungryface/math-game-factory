  1503	function drawTiles(rp, alpha){
  1504	  if(alpha<0.04) return;
  1505	  const cell=Math.max(14, S.px);
  1506	  ctx.save(); ctx.translate(S.lx,S.ly); ctx.globalAlpha=alpha;
  1507	  ctx.beginPath(); ctx.arc(0,0,rp-2,0,Math.PI*2); ctx.clip();
  1508	  ctx.fillStyle='#F2C14E';
  1509	  ctx.fillRect(-rp,-rp,rp*2,rp*2);
  1510	  ctx.strokeStyle='rgba(154,90,16,0.42)'; ctx.lineWidth=1.25;
  1511	  ctx.beginPath();
  1512	  const n=Math.ceil(rp/cell)+1;
  1513	  for(let i=-n;i<=n;i++){
  1514	    ctx.moveTo(i*cell, -rp); ctx.lineTo(i*cell, rp);
  1515	    ctx.moveTo(-rp, i*cell); ctx.lineTo(rp, i*cell);
  1516	  }
  1517	  ctx.stroke();
  1518	  ctx.restore();
  1519	}
