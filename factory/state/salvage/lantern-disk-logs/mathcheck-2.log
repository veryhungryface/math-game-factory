  1462	function drawSquareBed(task, rp){
  1463	  const side = task.square * S.px;
  1464	  ctx.save();
  1465	  ctx.translate(S.lx, S.ly);
  1466	  ctx.strokeStyle='#1C2422'; ctx.lineWidth=3;
  1467	  ctx.fillStyle='rgba(31,111,104,0.22)';
  1468	  ctx.fillRect(-side/2, -side/2, side, side);
  1469	  ctx.strokeRect(-side/2, -side/2, side, side);
  1470	  // 그늘 = 사각형 − 원
  1471	  ctx.fillStyle='rgba(28,36,34,0.35)';
  1472	  ctx.beginPath(); ctx.rect(-side/2,-side/2,side,side);
  1473	  ctx.moveTo(rp,0); ctx.arc(0,0,rp,0,Math.PI*2,true);
