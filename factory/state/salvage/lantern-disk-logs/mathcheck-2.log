  1623	      ctx.fillStyle='#1C2422';
  1624	      ctx.beginPath(); ctx.arc(-6,-2,3,0,Math.PI*2); ctx.arc(6,-2,3,0,Math.PI*2); ctx.fill();
  1625	      ctx.fillStyle='rgba(242,193,78,0.55)';
  1626	      ctx.beginPath(); ctx.ellipse(-12,-4,10,6,-0.4,0,Math.PI*2); ctx.ellipse(12,-4,10,6,0.4,0,Math.PI*2); ctx.fill();
  1627	      ctx.restore();
  1628	    }
