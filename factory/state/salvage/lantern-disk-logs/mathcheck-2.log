   616	function sampleProblems(n){
   617	  const g=mulberry32(0xA11CE);
   618	  const seen=new Set(), uniq=[];
   619	  for(const p of shuf(g, MC_POOL)){
   620	    if(seen.has(p.prompt)) continue;
   620	    if(seen.has(p.prompt)) continue;
   621	    seen.add(p.prompt); uniq.push(p);
   622	  }
   623	  return uniq.slice(0, Math.max(1, n|0));
   624	}
