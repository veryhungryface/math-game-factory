  1478	function drawGhosts(task){
  1479	  if(!task) return;
  1480	  ctx.save(); ctx.translate(S.lx,S.ly);
  1481	  for(const g of task.ghosts){
  1482	    if(g.r==null) continue;
  1483	    const rp=rpx(g.r);
  1484	    ctx.setLineDash([6,6]);
  1485	    ctx.strokeStyle = g.old ? 'rgba(242,193,78,0.45)' : 'rgba(226,74,42,0.55)';
  1486	    ctx.lineWidth=2.5;
  1487	    ctx.beginPath(); ctx.arc(0,0,rp,0,Math.PI*2); ctx.stroke();
  1488	    ctx.setLineDash([]);
  1489	    if(g.empty){
  1490	      ctx.strokeStyle='rgba(226,74,42,0.7)'; ctx.lineWidth=8;
  1491	      ctx.beginPath(); ctx.arc(0,0,rp,0,Math.PI*2); ctx.stroke();
  1492	    }
  1493	    if(g.stacked){
  1494	      ctx.globalAlpha=0.25; ctx.fillStyle='#F2C14E';
  1495	      ctx.beginPath(); ctx.arc(-8,-8,rpx(task.r0),0,Math.PI*2); ctx.fill();
  1496	      ctx.beginPath(); ctx.arc(8,8,rpx(task.r0),0,Math.PI*2); ctx.fill();
  1497	      ctx.globalAlpha=1;
  1498	    }
  1499	  }
  1500	  ctx.restore();
  1501	}
